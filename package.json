{
  "name": "ghostcast",
  "version": "0.1.0",
  "description": "A recording studio for coding agents: scripted, headless screencasts of real terminals, editors and web pages — cut, zoomed, captioned and voiced.",
  "type": "module",
  "bin": {
    "ghostcast": "bin/ghostcast.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "py/*.py",
    "templates/",
    "docs/",
    "SKILL.md"
  ],
  "scripts": {
    "test": "node --test test/unit.test.mjs test/smoke.test.mjs",
    "test:unit": "node --test test/unit.test.mjs",
    "test:smoke": "node --test test/smoke.test.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "playwright": "^1.63.0"
  },
  "keywords": [
    "screencast",
    "demo-video",
    "playwright",
    "vscode",
    "terminal",
    "agent",
    "ffmpeg"
  ],
  "license": "MIT"
}
