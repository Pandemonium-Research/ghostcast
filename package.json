{
  "name": "ghostcast",
  "version": "0.1.0",
  "description": "A recording studio for coding agents: scripted, headless screencasts of real terminals, editors and web pages — cut, zoomed, captioned and voiced.",
  "type": "module",
  "bin": {
    "ghostcast": "bin/ghostcast.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "templates/",
    "docs/scene-api.md",
    "docs/gotchas.md",
    "SKILL.md"
  ],
  "scripts": {
    "test": "node --test test/post.test.mjs test/unit.test.mjs test/world.test.mjs test/smoke.test.mjs test/shoot.test.mjs test/studio.test.mjs",
    "test:unit": "node --test test/post.test.mjs test/unit.test.mjs test/world.test.mjs test/studio.test.mjs",
    "test:smoke": "node --test test/smoke.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@lydell/node-pty": "1.2.0-beta.14",
    "@xterm/xterm": "^6.0.0",
    "playwright": "^1.63.0",
    "yaml": "^2.9.1"
  },
  "keywords": [
    "screencast",
    "demo-video",
    "playwright",
    "vscode",
    "terminal",
    "agent",
    "ffmpeg"
  ],
  "license": "MIT"
}
