{
  "name": "screencast",
  "viewport": { "width": 1440, "height": 810, "dpr": 2 },
  "output": { "width": 1920, "height": 1080, "fps": 30, "capSeconds": 180 },
  "browser": { "channel": "chrome" },
  "vscode": { "url": "http://127.0.0.1:8765", "tokenFile": "vscode/token" },
  "zoom": { "max": 2, "fill": 0.62 },
